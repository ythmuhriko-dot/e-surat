dex on GitHub, {stars} stars\",\"browse\":\"Browse\",\"browseDesc\":\"Discover pets, creators, and curated collections\",\"collectionsDesc\":\"Featured character sets: South Park, Pokémon, more\",\"creatorsDesc\":\"Leaderboard of who is shipping the most pets\",\"requestsDesc\":\"Vote on pets the community wants curated next\",\"kindsDesc\":\"Animals, characters, creatures, objects\",\"vibesDesc\":\"Cozy, edgy, mystical, heroic and more\",\"build\":\"Build\",\"buildDesc\":\"Make and ship your own pixel pet\",\"createDesc\":\"Hatch a pet with the Hatch Pet skill, 5 min from idea to sprite\",\"submitDesc\":\"Drop your pet folder so Petdex hosts it for everyone\",\"docsDesc\":\"Install the Petdex CLI and ship pets via npm\",\"builtWith\":\"Built with Petdex\",\"builtWithDesc\":\"Apps the community is shipping on the Petdex format\",\"communityDesc\":\"Discord server with shipping channels and voice rooms\",\"takedown\":\"Takedown\",\"takedownDesc\":\"Report a pet that uses your work\",\"openMore\":\"More links\",\"discover\":\"Discover\",\"make\":\"Make\",\"download\":\"Download\",\"downloadDesc\":\"macOS desktop app - your pet beside every agent\",\"signIn\":\"Sign in\",\"openUserMenu\":\"Open user menu\",\"myProfile\":\"My profile\",\"myFeedback\":\"My feedback\",\"admin\":\"Admin\",\"collaborator\":\"Collaborator\",\"manageAccount\":\"Manage account\",\"signOut\":\"Sign out\",\"more\":\"More\",\"explore\":\"Explore\"},\"home\":{\"surprise\":{\"eyebrow\":\"Featured surprise\",\"title\":\"A pet found you\",\"dismiss\":\"Dismiss surprise pet\",\"view\":\"View\",\"install\":\"Install\",\"shuffle\":\"Shuffle\",\"viewAria\":\"View {name}\",\"spriteAlt\":\"{name} surprise pet\"}},\"installCommand\":{\"installStep\":\"1. Install\",\"activateStep\":\"2. Activate in the app\",\"dropsInto\":\"Drops the pet pack into\",\"methodAria\":\"Install method\",\"platformAria\":\"Install platform\",\"tabs\":{\"cli\":\"CLI\"},\"macHelp\":{\"title\":\"On Mac, use Terminal.app\",\"openTerminal\":\"Open Spotlight with Command + Space, type Terminal, then press Return.\",\"pasteCommand\":\"Paste the command above and press Return. If macOS asks for permission, allow it.\",\"returnToCodex\":\"When it finishes, open Settings, Appearance, Pets, then select this pet.\"},\"steps\":{\"openCodex\":\"Open the ChatGPT desktop app,\",\"insideCodex\":\"inside the app to wake or tuck it away.\",\"andClick\":\"and click\",\"use\":\"Use\",\"findPet\":\"Find \u003cstrong\u003e{displayName}\u003c/strong\u003e under\"}},\"installCompact\":{\"seeGuide\":\"See full install guide\",\"themeCodexLabel\":\"Theme my Codex\",\"themeCodexHint\":\"Repaint Codex Desktop\"},\"leaderboard\":{\"metadata\":{\"title\":\"Petdex leaderboard\",\"description\":\"Top creators on Petdex: most pets approved, most loved, most installed.\"},\"eyebrow\":\"Top creators\",\"title\":\"Petdex leaderboard\",\"subtitle\":\"The artists shipping the most pets, getting the most love, and landing the most installs. Updated live.\",\"categoryAria\":\"Leaderboard category\",\"secondaryStats\":{\"pets\":\"pets\",\"likes\":\"likes\",\"installs\":\"installs\"},\"tabs\":{\"pets\":{\"label\":\"Most pets\",\"unit\":\"approved\",\"blurb\":\"Creators ranked by approved pets in the catalog.\",\"empty\":\"No approved submissions yet.\"},\"likes\":{\"label\":\"Most loved\",\"unit\":\"likes\",\"blurb\":\"Total likes earned across every pet a creator has shipped.\",\"empty\":\"Nobody's pets have collected likes yet.\"},\"installs\":{\"label\":\"Most installed\",\"unit\":\"installs\",\"blurb\":\"Total CLI installs aggregated across a creator's pets.\",\"empty\":\"No installs recorded yet.\"},\"rising\":{\"label\":\"Rising\",\"unit\":\"this week\",\"blurb\":\"Pets approved in the last 7 days. Caught fire? Ship more.\",\"empty\":\"No new pets approved this week.\"},\"collectors\":{\"label\":\"Collectors\",\"unit\":\"caught\",\"blurb\":\"Collectors ranked by how many approved pets they have caught.\",\"empty\":\"No collectors yet.\"}}},\"myFeedback\":{\"filters\":{\"unread\":\"Unread\",\"replied\":\"Replied\",\"waiting\":\"Waiting\",\"all\":\"All\"}},\"myPets\":{\"metadata\":{\"title\":\"My submissions\",\"description\":\"Track the status of every pet you've sent to Petdex, customize your profile, and edit live entries.\"},\"edit\":{\"confirmWithdraw\":\"Withdraw this edit? Current approved values stay live.\",\"pendingReview\":\"Pending review\",\"submittedPrefix\":\"Your edit was submitted\",\"submittedSuffix\":\". The page below shows the live approved version until Hunter signs off.\",\"viewEdit\":\"View edit\",\"withdraw\":\"Withdraw\",\"rejected\":\"Edit rejected\",\"tryAgain\":\"Try again\",\"open\":\"Edit pet\",\"modalTitle\":\"Edit pet\",\"modalBody\":\"Text changes may auto-approve if they pass all criteria. Asset swaps always go to manual review.\",\"fields\":{\"displayName\":\"Display name\",\"description\":\"Description\",\"tags\":\"Tags\"},\"tagsPlaceholder\":\"cat, desk-companion, cuddly\",\"tagsHelp\":\"Comma- or space-separated. Lowercase, max 8, hyphens ok.\",\"actions\":{\"cancel\":\"Cancel\",\"submit\":\"Submit edit for review\"},\"spritesheetLabel\":\"Spritesheet\",\"spritesheetHelp\":\"Replaces the current sprite. Goes to manual review.\",\"metaLabel\":\"Metadata (pet.json)\",\"metaHelp\":\"Replaces the current metadata. Goes to manual review.\",\"fileTooBig\":\"File exceeds 8 MB\",\"invalidImage\":\"Invalid image file\",\"invalidJson\":\"Invalid JSON file\",\"autoApproved\":\"Edit applied\",\"queuedForReview\":\"Edit submitted for review\",\"uploading\":\"Uploading...\"},\"eyebrow\":\"Dashboard\",\"submissionCount\":\"{count, plural, =0 {no submissions} =1 {1 submission} other {# submissions}}\",\"tabs\":{\"all\":\"All\",\"pending\":\"Pending\",\"approved\":\"Approved\",\"rejected\":\"Rejected\"},\"submitAnother\":\"Submit another\",\"emptyState\":\"No submissions in this state.\"},\"onboarding\":{\"skip\":\"Skip tour\"},\"openInCodex\":{\"label\":\"Open in Codex\",\"subtitle\":\"Install this pet in the ChatGPT desktop app\",\"ariaLabel\":\"Open {displayName} in the ChatGPT desktop app\"},\"desktopAnnounce\":{\"title\":\"Petdex Desktop 0.3.0\",\"imageAlt\":\"Petdex Desktop: a pixel pet floating beside the settings window, on macOS, Windows and Linux\",\"body\":\"Your pet now floats on macOS, Windows and Linux, and reacts to what your coding agent is doing.\",\"cta\":\"Download free\"},\"downloadHero\":{\"title\":\"Petdex Desktop\",\"subtitle\":\"A pixel pet that lives on your desktop and reacts to what your coding agent is doing.\",\"freeNote\":\"Free · macOS, Windows, Linux\",\"desktopOnly\":\"Petdex Desktop runs on a computer, not a phone.\",\"for\":{\"macos\":\"Download for macOS\",\"windows\":\"Download for Windows\",\"linux\":\"Download for Linux\"}},\"openInPetdex\":{\"eyebrow\":\"macOS desktop app\",\"label\":\"Open in Petdex Desktop\",\"subtitle\":\"Float this pet beside your coding agent\",\"opening\":\"Opening Petdex...\",\"ariaLabel\":\"Open {slug} in Petdex Desktop\"},\"ownerCollections\":{\"title\":\"My collections\",\"description\":\"Personal collections are private to your profile.\",\"editAria\":\"Edit collection\",\"deleteAria\":\"Delete collection\",\"cancelAria\":\"Cancel\",\"namePlaceholder\":\"South Park crew\",\"petsSelected\":\"Pets ({selected} of {total} selected)\"},\"petActions\":{\"moreActions\":\"More actions for {name}\",\"share\":\"Share\",\"reportTakedown\":\"Report\",\"reportTakedownAria\":\"Report {name} for takedown\",\"takedownDialog\":{\"eyebrow\":\"Legal · Takedown\",\"title\":\"Report a pet\",\"body\":\"Petdex hosts user-submitted fan-art pixel pets. We don't claim rights to the underlying IP of any character a community member chose to interpret. If you're a rights holder or authorized representative and want a pet removed, the fastest path is a GitHub issue.\",\"howItWorks\":\"How it works\",\"step1\":\"Open a takedown request with the button below.\",\"step2\":\"Tell us which pet and your relationship to the IP.\",\"step3\":\"We review manually. Typical response under 48 hours. Filings stay public on GitHub for transparency.\",\"step4\":\"Approved takedowns remove the pet from the gallery and installer endpoints.\",\"nonIp\":\"Non-IP issues such as broken sprites or wrong descriptions should use a regular issue instead.\",\"prefillLabel\":\"This request will prefill:\",\"confirmation\":\"By submitting to Petdex you confirm you have rights to the artwork or are creating fan content. Petdex acts on good-faith takedown requests.\",\"cancel\":\"Cancel\",\"openRequest\":\"Open takedown request\"},\"closeMenu\":\"Close menu\",\"openInCodex\":\"Open in Codex\",\"openInCodexHint\":\"Codex Desktop runs the install\",\"copiedInstall\":\"Copied install\",\"copyInstall\":\"Copy install\",\"copiedLink\":\"Copied link\",\"copyPageLink\":\"Copy page link\",\"shareToX\":\"Share to X\",\"shareToLinkedIn\":\"Share to LinkedIn\",\"more\":\"More…\",\"downloadZip\":\"Download ZIP\",\"removeFromPetdex\":\"Remove from Petdex\",\"removing\":\"Removing…\",\"withdrawSubmission\":\"Withdraw submission\",\"withdrawing\":\"Withdrawing…\",\"submitNewVersion\":\"Submit a new version\",\"editDetails\":\"Edit name \u0026 description\"},\"petStateViewer\":{\"eyebrow\":\"State viewer\",\"frames\":\"{count} frames\",\"rowFrames\":\"Row {row} - {count} frames\",\"animationLabel\":\"{petName} {state} animation\",\"states\":{\"idle\":{\"label\":\"Idle\",\"purpose\":\"Neutral breathing and blinking loop\"},\"running-right\":{\"label\":\"Run Right\",\"purpose\":\"Directional locomotion to the right\"},\"running-left\":{\"label\":\"Run Left\",\"purpose\":\"Directional locomotion to the left\"},\"waving\":{\"label\":\"Waving\",\"purpose\":\"Greeting or attention gesture\"},\"jumping\":{\"label\":\"Jumping\",\"purpose\":\"Anticipation, lift, peak, descent, settle\"},\"failed\":{\"label\":\"Failed\",\"purpose\":\"Readable error or sad reaction\"},\"waiting\":{\"label\":\"Waiting\",\"purpose\":\"Patient idle variant\"},\"running\":{\"label\":\"Running\",\"purpose\":\"Generic in-place run loop\"},\"review\":{\"label\":\"Review\",\"purpose\":\"Focused inspecting or thinking loop\"}}},\"pinnedReorder\":{\"reorderLabel\":\"Could not save order\",\"saveError\":\"Could not save order: {error}\"},\"profile\":{\"creatorBadge\":\"Petdex creator\",\"creatorOfPetdex\":\"Creator of Petdex\",\"yourAlbum\":\"YOUR ALBUM: {caught}/{total} ({pct}%)\",\"editProfile\":\"Edit profile\",\"petsTab\":\"Pets\",\"likedTab\":\"Liked\",\"collectionsTab\":\"Collections\",\"submitPet\":\"Submit pet\",\"approvedSection\":\"Approved ({count})\",\"editOrder\":\"Edit order\",\"joined\":\"joined {date}\",\"installs\":\"{count} installs\",\"petsCount\":\"{count, plural, =1 {1 pet} other {# pets}}\"},\"profileShare\":{\"share\":\"Share\",\"eyebrow\":\"Share this profile\",\"close\":\"Close\",\"copyLink\":\"Copy link\",\"copied\":\"Copied\",\"shareToX\":\"Share to X\",\"shareToLinkedIn\":\"Share to LinkedIn\",\"more\":\"More…\",\"shareText\":\"Check out {name}'s pet collection on Petdex\"},\"requests\":{\"view\":{\"form\":{\"title\":\"Request a pet\",\"titlePet\":\"Request a pet\",\"titleCollection\":\"Request a collection\",\"body\":\"Describe the pet you'd like to see: character, theme, vibe. If someone else already asked for the same thing, your submission turns into an upvote on theirs.\",\"bodyPet\":\"Describe the pet you'd like to see: character, theme, vibe. If someone else already asked for the same thing, your submission turns into an upvote on theirs.\",\"bodyCollection\":\"Describe the set you want: IP, brand, cast, theme, and what pets should belong together.\",\"type\":{\"pet\":\"Pet\",\"petBody\":\"One companion, character, object or creature.\",\"collection\":\"Collection\",\"collectionBody\":\"A collectible set like Pixar, Star Wars or GRAYCRAFT.\"},\"petHint\":\"Use Pet for one specific companion: a character, creature, object or desk buddy.\",\"collectionHint\":\"Use Collection for sets like Pixar, Star Wars, Pokémon starters or GRAYCRAFT: brand/IP name, pets that belong together and the official site.\",\"placeholder\":\"e.g. a Studio Ghibli chinchilla, a sleepy axolotl coder, Spider-Pig\",\"placeholderPet\":\"e.g. a Studio Ghibli chinchilla, a sleepy axolotl coder, Spider-Pig\",\"placeholderCollection\":\"e.g. Pixar desk buddies, Star Wars droids, Pokémon starters\",\"imageLabel\":\"Add reference image\",\"imageBody\":\"Optional. Images stay hidden until admin review.\",\"submit\":\"Request\",\"submitPet\":\"Request pet\",\"submitCollection\":\"Request collection\",\"sending\":\"Sending…\"},\"success\":{\"created\":\"Requested \\\"{query}\\\". Others can upvote it now.\",\"upvoted\":\"Upvoted existing request for \\\"{query}\\\". Now at {count} votes.\"},\"sort\":{\"top\":\"Top voted\",\"new\":\"Newest\",\"fulfilled\":\"Fulfilled\",\"searchPlaceholder\":\"Search requests…\"},\"badges\":{\"pet\":\"Pet\",\"collection\":\"Collection\",\"fulfilled\":\"Fulfilled\",\"imagePending\":\"Image in review\"},\"empty\":{\"title\":\"No requests yet. Be the first.\",\"beforeLink\":\"Or search\",\"link\":\"the gallery\",\"afterLink\":\"and request a pet directly from the no-results screen.\",\"noMatches\":\"No requests match \\\"{search}\\\".\",\"nothingInView\":\"Nothing in this view yet.\"},\"upvoteAria\":\"Upvote \\\"{query}\\\"\",\"moreVoters\":\"+{count} more\",\"errors\":{\"moreDetail\":\"Tell us a bit more ({min}-{max} chars).\",\"signInRequest\":\"Sign in to request a pet.\",\"submitFailed\":\"Submit failed ({status})\",\"imageType\":\"Use a PNG, JPG or WebP image.\",\"imageTooLarge\":\"Reference image must be 4 MB or smaller.\",\"imageUpload\":\"Image upload failed. Try again.\",\"networkRetry\":\"Network error, try again.\",\"signInUpvote\":\"Sign in to upvote.\",\"voteFailed\":\"Vote failed ({status})\",\"network\":\"Network error\"}}},\"sticker\":{\"ctaWeChat\":\"Save for WeChat\",\"ctaGeneric\":\"Save for WhatsApp\",\"ctaShort\"